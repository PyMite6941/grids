{
  "format": "grids",
  "version": 1,
  "title": "Monthly budget",
  "sheets": [
    {
      "name": "Sheet1",
      "cells": {
        "A1": "Category",
        "B1": "Amount",
        "C1": "Share",
        "E1": "Summary",
        "A2": "Rent",
        "B2": "1200",
        "C2": "=B2/B$10",
        "A3": "Groceries",
        "B3": "420",
        "C3": "=B3/B$10",
        "A4": "Transport",
        "B4": "95",
        "C4": "=B4/B$10",
        "A5": "Utilities",
        "B5": "160",
        "C5": "=B5/B$10",
        "A6": "Phone",
        "B6": "35",
        "C6": "=B6/B$10",
        "A7": "Fun",
        "B7": "180",
        "C7": "=B7/B$10",
        "A8": "Savings",
        "B8": "400",
        "C8": "=B8/B$10",
        "A10": "Total",
        "B10": "=SUM(B2:B8)",
        "C10": "=SUM(C2:C8)",
        "E2": "Biggest",
        "F2": "=MAX(B2:B8)",
        "E3": "Average",
        "F3": "=ROUND(AVERAGE(B2:B8), 2)",
        "E4": "Over $150",
        "F4": "=py sum(1 for v in vals('B2:B8') if v > 150)",
        "E6": "Sorted",
        "F6": "=SORT(B2:B8, 1, FALSE)"
      },
      "formats": {
        "A1": {
          "bold": true,
          "bg": "#e8f0fe"
        },
        "B1": {
          "bold": true,
          "bg": "#e8f0fe"
