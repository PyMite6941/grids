        },
        "F1": {
          "bold": true,
          "bg": "#e8f0fe"
        },
        "A10": {
          "bold": true
        },
        "B10": {
          "bold": true,
          "numFmt": "$#,##0.00"
        },
        "C10": {
          "bold": true,
          "numFmt": "0.00%"
        },
