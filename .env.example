# Copy to .env (same folder) or ~/.grids/.env — or run `npm run setup` in web/, or use the app's AI → Keys screen.
# .env is git-ignored. Full rules: shared/KEYS.md

# API keys: AI_KEY_<NAME>, NAME = A-Z 0-9 _
# AI_KEY_GROQ1="gsk_..."
# AI_KEY_GROQ1_LIMIT=1000                               # requests/day before Auto stops picking it
# AI_KEY_OPENROUTER="sk-or-..."
# AI_KEY_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_KEY_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Subscriptions you already pay for, used through the vendor's own CLI (signed in once):
# AI_SUB_CLAUDE=claude          # Claude Pro/Max via Claude Code
# AI_SUB_CLAUDE_MODEL=sonnet
# AI_SUB_CHATGPT=codex          # ChatGPT Plus/Pro via Codex CLI
# AI_SUB_GEMINI=gemini          # Google account via Gemini CLI

# Defaults for keys that don't set their own (Groq + gpt-oss-120b if unset)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b

# Which connection to use: auto (most headroom left) or a NAME
# AI_KEY_SELECT=auto
